@model IEnumerable<Room>
@{ViewData["Title"] = "My Rooms";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-building me-2"></i>My Rooms</h1>
    <a asp-action="PostRoom" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Post New Room</a>
</div>

@if (!Model.Any())
{
    <div class="brf-card">
        <div class="empty-state">
            <i class="bi bi-building-add"></i>
            <h5>No rooms posted yet</h5>
            <p>Start by posting your first room listing</p>
            <a asp-action="PostRoom" class="btn btn-primary mt-2">Post a Room</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            var photo = r.Photos?.FirstOrDefault(p => p.IsPrimary) ?? r.Photos?.FirstOrDefault();
            <div class="col-md-6 col-lg-4">
                <div class="room-card">
                    @if (photo != null)
                    {
                        <img src="@photo.PhotoPath" class="room-card-img" alt="@r.Title"/>
                    }
                    else
                    {
                        <div class="room-card-img-placeholder"><i class="bi bi-building text-muted" style="font-size:2rem"></i></div>
                    }
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-700 mb-0">@r.Title</h6>
                            <span class="badge-status @(r.Status==RoomStatus.Active?"badge-active":r.Status==RoomStatus.PendingApproval?"badge-pending":r.Status==RoomStatus.Rented?"badge-rented":"badge-draft")">@r.Status</span>
                        </div>
                        <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@r.Thana, @r.District</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="rent-badge">৳@r.MonthlyRent.ToString("N0")/mo</span>
                            <span class="text-muted small"><i class="bi bi-eye me-1"></i>@r.ViewCount views</span>
                        </div>
                        <div class="d-flex gap-2 mb-2 flex-wrap">
                            @foreach (var f in (r.Facilities ?? new List<RoomFacility>()).Take(4))
                            {<span class="facility-chip">@f.FacilityName</span>}
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-controller="UserDashboard" asp-action="RoomDetail" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary flex-fill"><i class="bi bi-eye"></i> View</a>
                            <a asp-controller="Owner" asp-action="Applications" class="btn btn-sm btn-outline-warning flex-fill"><i class="bi bi-people"></i> Apps</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
