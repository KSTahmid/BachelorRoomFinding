@model ResetPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"/><title>Reset Password — BRF</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="~/css/site.css"/></head>
<body class="auth-page">
<div class="auth-card">
    <div class="auth-logo">
        <div class="logo-icon" style="color:#16A34A"><i class="bi bi-shield-lock-fill"></i></div>
        <h1>Reset Password</h1>
        <p>Choose a new secure password</p>
    </div>
    <form asp-action="ResetPassword" method="post">
        <input asp-for="Token" type="hidden"/>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>
        <div class="mb-3">
            <label class="form-label">New Password</label>
            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 6 characters"/>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control"/>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-success w-100 py-2">Reset Password</button>
    </form>
</div>
</body></html>
