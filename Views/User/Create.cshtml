@model BachelorRoomFinding.Entities.User
@{ViewData["Title"] = "Create User";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-person-plus me-2"></i>Create User</h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="form-card" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

        <div class="mb-3">
            <label class="form-label">Username *</label>
            <input asp-for="UserName" class="form-control" placeholder="e.g. rahim_dhaka"/>
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Email *</label>
            <input asp-for="Email" class="form-control" placeholder="user@email.com"/>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Password *</label>
            <input name="plainPassword" type="password" class="form-control" placeholder="Min 6 characters" required/>
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="+8801XXXXXXXXX"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Address</label>
            <input asp-for="Address" class="form-control" placeholder="Area, City"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Role *</label>
            @if (ViewBag.Roles != null)
            {
                <select name="RoleId" class="form-select">
                    <option value="">-- Select Role --</option>
                    @foreach (var role in (IEnumerable<BachelorRoomFinding.Entities.Role>)ViewBag.Roles)
                    {
                        <option value="@role.Id">@role.RoleName — @role.RoleDescription</option>
                    }
                </select>
            }
            else
            {
                <div class="alert alert-warning py-2 small">No roles found. Please seed the database first.</div>
            }
        </div>
        <div class="mb-3">
            <div class="form-check form-switch">
                <input asp-for="IsApprovedByAdmin" class="form-check-input" type="checkbox" checked/>
                <label class="form-check-label small">Approved by Admin</label>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create User</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>