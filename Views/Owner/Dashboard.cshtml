@{ViewData["Title"] = "Owner Dashboard";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-speedometer2 me-2 text-warning"></i>Owner Dashboard</h1>
    <a asp-action="PostRoom" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Post New Room</a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-building"></i></div>
            <div><div class="stat-value">@ViewBag.MyRooms</div><div class="stat-label">My Rooms</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
            <div><div class="stat-value">@ViewBag.ActiveRooms</div><div class="stat-label">Active</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon yellow"><i class="bi bi-file-earmark-person"></i></div>
            <div><div class="stat-value">@ViewBag.PendingApps</div><div class="stat-label">Pending Apps</div></div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-eye"></i></div>
            <div><div class="stat-value">@ViewBag.TotalViews</div><div class="stat-label">Total Views</div></div>
        </div>
    </div>
</div>

<!-- Recent Applications -->
<div class="brf-card">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-600"><i class="bi bi-file-earmark-person me-2 text-primary"></i>Recent Applications</h6>
        <a asp-action="Applications" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    @{var apps = ViewBag.RecentApplications as List<RentalApplication>;}
    @if (apps == null || !apps.Any())
    {
        <div class="empty-state"><i class="bi bi-inbox"></i><h5>No applications yet</h5><p>Applications for your rooms will appear here</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table brf-table mb-0">
                <thead><tr><th>Room</th><th>Applicant</th><th>Move-in</th><th>Applied</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var a in apps)
                {
                    <tr>
                        <td class="fw-600 small">@a.Room?.Title</td>
                        <td class="small">@a.Applicant?.UserName</td>
                        <td class="small">@a.MoveInDate.ToString("dd MMM yyyy")</td>
                        <td class="small text-muted">@a.AppliedAt.ToString("dd MMM")</td>
                        <td><span class="badge-status @(a.Status==ApplicationStatus.Approved?"badge-approved":a.Status==ApplicationStatus.Rejected?"badge-rejected":"badge-pending")">@a.Status</span></td>
                        <td>
                            @if (a.Status == ApplicationStatus.Pending)
                            {
                                <form asp-action="ApproveApplication" asp-route-id="@a.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-success btn-sm-action"><i class="bi bi-check"></i></button>
                                </form>
                                <form asp-action="DeclineApplication" asp-route-id="@a.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-danger btn-sm-action"><i class="bi bi-x"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
