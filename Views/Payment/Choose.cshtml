@{
    ViewData["Title"] = "Choose Payment Method";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h3 class="fw-bold mb-4">Pay Advance</h3>
                    <p class="text-muted mb-4">Amount to pay: <strong>@ViewBag.Amount BDT</strong></p>
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (ViewBag.IsDemoNumber == true)
                    {
                        <div class="alert alert-warning">
                            এই owner এর payment number টি demo। বাস্তব পেমেন্ট করা যাবে না।
                        </div>
                    }

                    <form asp-action="Initiate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="applicationId" value="@ViewBag.ApplicationId" />
                        <input type="hidden" name="amount" value="@ViewBag.Amount" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Payment Method</label>
                            <select name="method" id="methodSelect" class="form-select form-select-lg mb-3" required onchange="updateRecipientNumber()">
                                <option value="" disabled selected>-- Choose Method --</option>
                                @if (ViewBag.IsDemoNumber == true)
                                {
                                    <option value="bKash" disabled>bKash</option>
                                    <option value="Nagad" disabled>Nagad</option>
                                }
                                else
                                {
                                    <option value="bKash">bKash</option>
                                    <option value="Nagad">Nagad</option>
                                }
                                <option value="BankTransfer">Bank Transfer</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Owner recipient number</label>
                            <input id="recipientNumber" class="form-control" value="@ViewBag.OwnerBkash" readonly />
                            @if (ViewBag.IsDemoNumber == true)
                            {
                                <span class="badge bg-warning text-dark mt-2">Demo</span>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Your wallet number</label>
                            <input name="senderWalletNumber" class="form-control" placeholder="01XXXXXXXXX" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Proceed to Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateRecipientNumber() {
            const method = document.getElementById('methodSelect').value;
            document.getElementById('recipientNumber').value = method === 'Nagad'
                ? '@ViewBag.OwnerNagad'
                : '@ViewBag.OwnerBkash';
        }
    </script>
}
