@model RegisterViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Register — MessBasha</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page">
<div class="auth-card" style="max-width:520px">
    <div class="auth-logo">
        <div class="logo-icon"><i class="bi bi-person-plus-fill"></i></div>
        <h1>Create Account</h1>
        <p>Join MessBasha — Find or list rooms in Bangladesh</p>
    </div>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

        <!-- Role Selection -->
        <div class="mb-3">
            <label class="form-label">I want to...</label>
            <div class="d-flex gap-2">
                <input type="radio" class="btn-check" name="Role" id="roleUser" value="User" checked />
                <label class="btn btn-outline-primary flex-fill" for="roleUser"><i class="bi bi-search me-1"></i>Find a Room</label>
                <input type="radio" class="btn-check" name="Role" id="roleOwner" value="Owner" />
                <label class="btn btn-outline-warning flex-fill" for="roleOwner"><i class="bi bi-building me-1"></i>List Rooms</label>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input asp-for="UserName" class="form-control" placeholder="Rahim Uddin" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+8801XXXXXXXXX" />
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="you@email.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-2">
            <label class="form-label">Address / Area</label>
            <input asp-for="Address" class="form-control" placeholder="Mirpur, Dhaka" />
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Min 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2 fw-600 mt-2">
            <i class="bi bi-person-check me-2"></i>Create Account
        </button>
    </form>
    <p class="text-center mt-3 small text-muted">
        Already have an account? <a asp-action="Login" class="text-primary fw-600">Sign in</a>
    </p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
