@model User
@{ViewData["Title"] = "Edit Owner Payment Number";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-wallet2 me-2"></i>Edit Payment Number</h1>
    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">Back to Users</a>
</div>

<div class="brf-card p-4" style="max-width:720px">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="avatar-sm" style="width:52px;height:52px;background:#D97706;font-size:1.2rem">
            @(Model.UserName.Length > 0 ? Model.UserName[0].ToString().ToUpper() : "O")
        </div>
        <div>
            <h5 class="mb-0">@Model.UserName</h5>
            <div class="text-muted small">@Model.Email</div>
        </div>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.UserId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">bKash Number</label>
                <input name="bkashNumber" value="@Model.BkashNumber" class="form-control" placeholder="01XXXXXXXXX" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Nagad Number</label>
                <input name="nagadNumber" value="@Model.NagadNumber" class="form-control" placeholder="01XXXXXXXXX" />
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isDemoNumber" value="true" id="isDemoNumber" @(Model.IsDemoNumber ? "checked" : "") />
                    <input type="hidden" name="isDemoNumber" value="false" />
                    <label class="form-check-label fw-bold" for="isDemoNumber">Demo payment number</label>
                    <div class="form-text">Turn this off only for real sandbox-test owner numbers.</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary">Save Payment Numbers</button>
            <a asp-action="Users" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
