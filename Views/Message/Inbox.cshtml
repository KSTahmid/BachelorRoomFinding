@{ViewData["Title"] = "Inbox";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-chat-dots me-2"></i>Messages</h1>
</div>

@{var inbox = ViewBag.Inbox as List<(BachelorRoomFinding.Entities.User user, BachelorRoomFinding.Entities.Message lastMsg, int unread)>;}

@if (inbox == null || !inbox.Any())
{
    <div class="brf-card"><div class="empty-state"><i class="bi bi-chat"></i><h5>No messages yet</h5><p>Start a conversation from a room listing</p></div></div>
}
else
{
    <div class="brf-card" style="max-width:700px">
        @foreach (var (user, lastMsg, unread) in inbox)
        {
            <a asp-action="Conversation" asp-route-userId="@user.UserId"
               class="d-flex align-items-center gap-3 p-3 border-bottom text-decoration-none text-dark @(unread>0?"bg-light":"")">
                <div class="avatar-sm" style="width:44px;height:44px;font-size:1.1rem;flex-shrink:0">
                    @(user.UserName[0].ToString().ToUpper())
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex justify-content-between">
                        <span class="fw-600 small">@user.UserName</span>
                        <span class="text-muted" style="font-size:.72rem">@lastMsg.SentAt.ToString("dd MMM HH:mm")</span>
                    </div>
                    <div class="text-muted small text-truncate">
                        @(lastMsg.Content.Length > 60 ? lastMsg.Content[..60]+"..." : lastMsg.Content)
                    </div>
                </div>
                @if (unread > 0)
                { <span class="badge bg-primary rounded-pill">@unread</span> }
            </a>
        }
    </div>
}
