@{
    ViewData["Title"] = $"{ViewBag.Method} Payment Gateway";
    Layout = null;

    bool isBkash = ((string)ViewBag.Method) == "bKash";
    string primaryColor = isBkash ? "#e2136e" : "#f5a623";
    string headerBg     = isBkash ? "#e2136e" : "#f5a623";
    string confirmColor = isBkash ? "#e2136e" : "#f5a623";
    string logoUrl = isBkash
        ? "https://upload.wikimedia.org/wikipedia/en/thumb/c/c8/BKash_Logo.svg/1200px-BKash_Logo.svg.png"
        : "https://upload.wikimedia.org/wikipedia/commons/thumb/9/9c/Nagad.svg/1200px-Nagad.svg.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * { box-sizing: border-box; }
        body { background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; justify-content: center; min-height: 100vh; margin: 0; font-family: 'Segoe UI', Arial, sans-serif; }

        .gateway-modal {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px 20px 0 0;
            overflow: hidden;
            box-shadow: 0 -6px 30px rgba(0,0,0,0.2);
            animation: slideUp 0.35s ease;
        }
        @@keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

        /* White logo bar */
        .logo-bar { background: #fff; padding: 16px 20px 12px; text-align: center; border-bottom: 1px solid #f0f0f0; }
        .logo-bar img { max-height: 42px; max-width: 160px; object-fit: contain; }

        /* Merchant info bar */
        .merchant-bar { background: #fff; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f0f0f0; }
        .merchant-left { display: flex; align-items: center; gap: 10px; }
        .merchant-icon { width: 38px; height: 38px; background: #e8f4fd; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .merchant-name { font-weight: 700; font-size: 14px; color: #222; margin: 0; }
        .merchant-inv { font-size: 11px; color: #999; margin: 0; }
        .merchant-amount { font-size: 20px; font-weight: 800; color: #222; }

        /* Colored interaction area */
        .interaction-area { background: @primaryColor; padding: 28px 24px 24px; text-align: center; }
        .interaction-area label { display: block; color: rgba(255,255,255,0.92); font-size: 15px; margin-bottom: 14px; font-weight: 400; }
        .interaction-area input {
            width: 100%; padding: 13px 16px; border-radius: 8px; border: none;
            font-size: 17px; text-align: center; color: #333; font-weight: 500;
            outline: none; box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }
        .interaction-area input:focus { box-shadow: 0 0 0 3px rgba(255,255,255,0.4); }
        .terms-note { color: rgba(255,255,255,0.8); font-size: 12px; margin-top: 10px; }
        .terms-note a { color: #fff; text-decoration: underline; }

        /* Error message */
        .error-in-area { color: #fff; background: rgba(0,0,0,0.25); border-radius: 6px; padding: 8px 12px; font-size: 13px; margin-top: 10px; }

        /* Action buttons */
        .action-bar { display: flex; background: #f7f7f7; border-top: 1px solid #ececec; }
        .btn-cancel-action { flex: 1; padding: 14px; background: #fff; border: none; border-right: 1px solid #ececec; color: #555; font-size: 15px; font-weight: 600; cursor: pointer; }
        .btn-confirm-action { flex: 1; padding: 14px; background: #ddd; border: none; color: #aaa; font-size: 15px; font-weight: 700; cursor: default; transition: all 0.25s; }
        .btn-confirm-action.ready { background: @confirmColor; color: #fff; cursor: pointer; }

        /* Footer */
        .gateway-footer { background: #fff; padding: 10px; text-align: center; font-size: 11px; color: #aaa; border-top: 1px solid #f0f0f0; }
        .gateway-footer .hotline { color: @primaryColor; font-weight: 700; font-size: 12px; }
    </style>
</head>
<body>

<div class="gateway-modal">

    <!-- Logo -->
    <div class="logo-bar">
        <img src="@logoUrl" alt="@ViewBag.Method"
             onerror="this.style.display='none'; document.getElementById('logoText').style.display='block'" />
        <strong id="logoText" style="display:none; font-size:22px; color:@primaryColor;">@ViewBag.Method</strong>
    </div>

    <!-- Merchant info -->
    <div class="merchant-bar">
        <div class="merchant-left">
            <div class="merchant-icon">🏠</div>
            <div>
                <p class="merchant-name">Bachelor Room Finding</p>
                <p class="merchant-inv">Inv No: BRF-@ViewBag.PaymentId</p>
            </div>
        </div>
        <div class="merchant-amount">৳@ViewBag.Amount</div>
    </div>

    <!-- STEP 1: Wallet Number -->
    <form asp-action="MockGatewaySubmit" method="post" id="paymentForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="paymentId" value="@ViewBag.PaymentId" />
        <input type="hidden" name="method" value="@ViewBag.Method" />
        <!-- otp and pin are always valid so backend passes -->
        <input type="hidden" name="otp" id="hiddenOtp" value="" />
        <input type="hidden" name="pin" id="hiddenPin" value="" />

        @if (TempData["Error"] != null)
        {
            <div class="interaction-area" style="padding-bottom:10px;">
                <div class="error-in-area">@TempData["Error"]</div>
            </div>
        }

        <!-- Step 1: Wallet number -->
        <div id="step1" class="interaction-area">
            <label>Your @ViewBag.Method Account Number</label>
            <input type="tel" id="walletInput" placeholder="e.g. 01XXXXXXXXX"
                   value="@ViewBag.SenderPhone"
                   maxlength="11" oninput="onWalletInput(this)" autocomplete="tel" />
            <div class="terms-note">
                Confirm and proceed, <a href="#">terms &amp; conditions</a>
            </div>
        </div>

        <!-- Step 2: OTP -->
        <div id="step2" class="interaction-area" style="display:none;">
            <label>Enter Verification Code</label>
            <input type="tel" id="otpInput" placeholder="6-digit code"
                   maxlength="6" oninput="onOtpInput(this)" autocomplete="one-time-code" />
            <div class="terms-note">A verification code has been sent to your registered number.</div>
        </div>

        <!-- Step 3: PIN -->
        <div id="step3" class="interaction-area" style="display:none;">
            <label>Enter @ViewBag.Method PIN</label>
            <input type="password" id="pinInput" placeholder="5-digit PIN"
                   maxlength="5" oninput="onPinInput(this)" autocomplete="current-password" />
            <div class="terms-note">Your PIN is kept private and secure.</div>
        </div>

        <div class="action-bar">
            <button type="button" class="btn-cancel-action" id="cancelBtn" onclick="goBack()">Cancel</button>
            <!-- Step 1 confirm -->
            <button type="button" class="btn-confirm-action" id="confirmStep1" disabled onclick="goToStep(2)">Confirm</button>
            <!-- Step 2 confirm -->
            <button type="button" class="btn-confirm-action" id="confirmStep2" disabled style="display:none;" onclick="goToStep(3)">Confirm</button>
            <!-- Step 3 (final submit) -->
            <button type="submit" class="btn-confirm-action" id="confirmStep3" disabled style="display:none;">Confirm</button>
        </div>
    </form>

    <div class="gateway-footer">
        <span class="hotline">&#9742; 16247</span><br />
        &copy; 2026 @ViewBag.Method, All Rights Reserved
    </div>

</div>

<script>
    var currentStep = 1;

    function onWalletInput(el) {
        var val = el.value.replace(/\D/g, '');
        el.value = val;
        var btn = document.getElementById('confirmStep1');
        if (val.length >= 11) {
            btn.disabled = false;
            btn.classList.add('ready');
        } else {
            btn.disabled = true;
            btn.classList.remove('ready');
        }
    }

    function onOtpInput(el) {
        var val = el.value.replace(/\D/g, '');
        el.value = val;
        document.getElementById('hiddenOtp').value = val;
        var btn = document.getElementById('confirmStep2');
        if (val.length >= 4) {
            btn.disabled = false;
            btn.classList.add('ready');
        } else {
            btn.disabled = true;
            btn.classList.remove('ready');
        }
    }

    function onPinInput(el) {
        var val = el.value.replace(/\D/g, '');
        el.value = val;
        document.getElementById('hiddenPin').value = val;
        var btn = document.getElementById('confirmStep3');
        if (val.length >= 4) {
            btn.disabled = false;
            btn.classList.add('ready');
        } else {
            btn.disabled = true;
            btn.classList.remove('ready');
        }
    }

    function goToStep(step) {
        // Hide all steps and confirm buttons
        for (var i = 1; i <= 3; i++) {
            document.getElementById('step' + i).style.display = 'none';
            var c = document.getElementById('confirmStep' + i);
            if (c) c.style.display = 'none';
        }
        // Show the requested step
        document.getElementById('step' + step).style.display = 'block';
        document.getElementById('confirmStep' + step).style.display = 'block';
        currentStep = step;

        // Focus the input in the new step
        var inputs = document.getElementById('step' + step).querySelectorAll('input');
        if (inputs.length > 0) inputs[0].focus();
    }

    function goBack() {
        if (currentStep > 1) {
            goToStep(currentStep - 1);
        } else {
            window.history.back();
        }
    }

    // Pre-fill hidden fields for backend
    document.getElementById('hiddenOtp').value = '1234';
    document.getElementById('hiddenPin').value = '1234';

    // Trigger initial wallet check in case value is pre-filled
    var w = document.getElementById('walletInput');
    if (w.value.length >= 11) {
        document.getElementById('confirmStep1').disabled = false;
        document.getElementById('confirmStep1').classList.add('ready');
    }
</script>

</body>
</html>
