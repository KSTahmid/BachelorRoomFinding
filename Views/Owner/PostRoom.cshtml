@model RoomCreateViewModel
@{ViewData["Title"] = "Post a Room";}

@{
    var facilities = new[]{"Fan", "WiFi", "Attached Bathroom", "Shared Bathroom", "Balcony", "Reading Table", "Wardrobe", "Bed Included", "Generator/IPS", "Drinking Water", "Gas Facility", "Kitchen Access", "Fridge Sharing", "Dining System", "Security/CCTV", "Laundry Nearby", "Bike Parking", "Lift"};
    var districts  = new[]{"Dhaka","Chattogram","Sylhet","Rajshahi","Khulna","Barisal","Rangpur","Mymensingh"};
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-plus-circle me-2 text-primary"></i>Post a New Room</h1>
    <a asp-action="MyRooms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>My Rooms</a>
</div>

<form asp-action="PostRoom" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

    <div class="row g-3">
        <!-- Left Column -->
        <div class="col-lg-8">
            <div class="form-card mb-3">
                <p class="section-label">Basic Info</p>
                <div class="mb-3">
                    <label class="form-label">Room Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Spacious Single Room in Mirpur 10"/>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the room, amenities, surroundings..."></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Room Type *</label>
                        <select asp-for="RoomType" class="form-select">
                            <option value="MaleMess">Male Mess</option>
                            <option value="FemaleHostel">Female Hostel</option>
                            <option value="SharedSeat">Shared Seat</option>
                            <option value="SingleRoom">Single Room</option>
                            <option value="Sublet">Sublet</option>
                            <option value="BachelorFlat">Bachelor Flat</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bedrooms</label>
                        <input asp-for="BedroomCount" type="number" min="1" max="20" class="form-control"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Available From</label>
                        <input asp-for="AvailableFrom" type="date" class="form-control"/>
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <p class="section-label">Location</p>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">District *</label>
                        <select asp-for="District" class="form-select">
                            <option value="">-- Select --</option>
                            @foreach(var d in districts){ <option value="@d">@d</option> }
                        </select>
                        <span asp-validation-for="District" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Thana/Area *</label>
                        <input asp-for="Thana" class="form-control" placeholder="e.g. Mirpur 10"/>
                        <span asp-validation-for="Thana" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Full Address *</label>
                        <input asp-for="Address" class="form-control" placeholder="House/Road/Block"/>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <p class="section-label">Facilities</p>
                <div class="row g-2">
                    @foreach (var f in facilities)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedFacilities" value="@f" id="fac_@f.Replace(" ","_")"
                                       @(Model.SelectedFacilities.Contains(f) ? "checked" : "")/>
                                <label class="form-check-label small" for="fac_@f.Replace(" ","_")">@f</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-card mb-3">
                <p class="section-label">House Rules</p>
                <div class="row g-2">
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input asp-for="SmokingAllowed" class="form-check-input" type="checkbox"/>
                            <label class="form-check-label small">Smoking Allowed</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input asp-for="GuestAllowed" class="form-check-input" type="checkbox"/>
                            <label class="form-check-label small">Guest Allowed</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input asp-for="BachelorOnly" class="form-check-input" type="checkbox"/>
                            <label class="form-check-label small">Bachelor Only</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input asp-for="FamilyRestricted" class="form-check-input" type="checkbox"/>
                            <label class="form-check-label small">Family Restricted</label>
                        </div>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label class="form-label small">Curfew Timing</label>
                        <input asp-for="CurfewTiming" class="form-control form-control-sm" placeholder="e.g. 10:30 PM"/>
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <p class="section-label">Media (max 15MB each, images/videos)</p>
                <input type="file" name="MediaFiles" class="form-control" multiple accept="image/*,video/mp4,video/webm"/>
                <div class="form-text">Upload multiple photos and videos. First file will be the cover.</div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <div class="form-card mb-3">
                <p class="section-label">Pricing (BDT ৳)</p>
                <div class="mb-3">
                    <label class="form-label">Monthly Rent *</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="MonthlyRent" type="number" class="form-control" placeholder="0"/>
                    </div>
                    <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Seat Rent</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="SeatRent" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Electricity Bill</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="ElectricityBill" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">WiFi Bill</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="WiFiBill" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Gas Bill</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="GasBill" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Water Bill</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="WaterBill" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Service Charge</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="ServiceCharge" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Meal Cost</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="MealCost" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Security Deposit / Advance</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="SecurityDeposit" type="number" class="form-control" placeholder="0"/>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <p class="section-label">Submit</p>
                <p class="text-muted small">Your room will be reviewed by admin before going live.</p>
                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-send me-2"></i>Submit for Approval
                </button>
                <a asp-action="MyRooms" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
            </div>
        </div>
    </div>
</form>
