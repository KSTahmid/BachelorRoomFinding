@model List<BachelorRoomFinding.Entities.RentalApplication>
@{
    ViewData["Title"] = "Mess Setup";
    var ownerRooms = ViewBag.OwnerRooms as List<BachelorRoomFinding.Entities.Room> ?? new List<BachelorRoomFinding.Entities.Room>();
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="brf-card p-4 text-center mb-4" style="border-radius:12px;border:0.5px solid #e0e0e0;">
            <div class="mb-3">
                <div style="width:72px;height:72px;background:#E1F5EE;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;">
                    <i class="bi bi-diagram-3 text-primary fs-1"></i>
                </div>
            </div>
            <h4>MessBoard Community Feature</h4>
            <p class="text-muted small">
                Manage your mess, assign rosters, split costs (Bazar, Utility, Gas), vote on meal menus, and log damage reports with your roommates.
            </p>
            <hr class="opacity-10 my-4" />

            <!-- Invite Code Join -->
            <form asp-action="JoinByInvite" method="post" class="text-start mb-4">
                @Html.AntiForgeryToken()
                <label class="form-label fw-bold">Join MessBoard via Invite Code</label>
                <div class="input-group">
                    <input name="inviteCode" class="form-control text-uppercase" placeholder="Enter 8-character code" required />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i>Join Community</button>
                </div>
                <small class="text-muted">Ask your Mess Manager or Owner for the invite code.</small>
            </form>

            @if (ownerRooms.Any())
            {
                <div class="text-start mb-4 border-top pt-3">
                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-house-door me-2"></i>Owner Rooms</h6>
                    <div class="list-group list-group-flush border rounded">
                        @foreach (var room in ownerRooms)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@room.Title</div>
                                    <div class="small text-muted">@room.Address</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createModalOwner_@room.Id">
                                    Setup MessBoard
                                </button>
                            </div>

                            <!-- Modal for Owner -->
                            <div class="modal fade text-start" id="createModalOwner_@room.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold">Create MessBoard Community</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="CreateGroup" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roomId" value="@room.Id" />
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Mess / Building Name</label>
                                                    <input type="text" name="name" class="form-control" placeholder="e.g. Dreamer's Bachelor Mess" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Create MessBoard</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!Model.Any() && !ownerRooms.Any())
            {
                <div class="alert alert-warning small text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>You are not currently an approved tenant or owner of an active room. You must rent a room first or enter an invite code to join its mess group.
                </div>
                <a asp-controller="UserDashboard" asp-action="Browse" class="btn btn-primary w-100">Find a Room to Rent</a>
            }
            else if (Model.Any())
            {
                <p class="small fw-500 text-start mb-2">Select your rented room:</p>
                <div class="list-group list-group-flush text-start border rounded mb-3">
                    @foreach (var app in Model)
                    {
                        <div class="list-group-item p-3">
                            <div class="fw-bold">@app.Room?.Title</div>
                            <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@app.Room?.Address</div>
                            
                            <div class="d-flex gap-2">
                                <form asp-action="JoinGroup" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roomId" value="@app.RoomId" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">Join MessBoard</button>
                                </form>
                                <button type="button" class="btn btn-primary btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#createModal_@app.RoomId">
                                    Create MessBoard
                                </button>
                            </div>
                        </div>

                        <!-- Create Group Modal -->
                        <div class="modal fade" id="createModal_@app.RoomId" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Create MessBoard Community</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="CreateGroup" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roomId" value="@app.RoomId" />
                                        <div class="modal-body">
                                            <p class="small text-muted mb-3">You will be designated as the initial Mess Admin manager.</p>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Community Name</label>
                                                <input type="text" name="name" class="form-control" placeholder="e.g. Uttara Mess Committee" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0">
                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Create MessBoard</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
