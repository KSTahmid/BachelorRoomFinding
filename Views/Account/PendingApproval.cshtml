@{
    ViewData["Title"] = "Account Under Review";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Under Review — MessBasha</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #F1EFE8; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { border: 0.5px solid #e0e0e0; border-radius: 12px; max-width: 500px; width: 100%; }
        .icon-circle { width: 72px; height: 72px; border-radius: 50%; background: #FFF3CD; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem; }
        .step { display: flex; gap: 12px; padding: 10px 0; border-bottom: 0.5px solid #f0f0f0; }
        .step:last-child { border-bottom: none; }
        .step-num { width: 24px; height: 24px; border-radius: 50%; background: #E1F5EE; color: #0F6E56; font-size: 12px; font-weight: 500; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
        .btn-primary-brf { background: #0F6E56; border: none; color: #fff; border-radius: 8px; padding: 10px 24px; font-size: 14px; font-weight: 500; }
        .btn-primary-brf:hover { background: #0a5240; color: #fff; }
        .btn-outline-brf { background: white; border: 0.5px solid #0F6E56; color: #0F6E56; border-radius: 8px; padding: 10px 24px; font-size: 14px; font-weight: 500; }
        .btn-outline-brf:hover { background: #E1F5EE; color: #085041; }
    </style>
</head>
<body>
    <div class="card p-5 shadow-sm">
        <div class="text-center">
            <div class="icon-circle">
                <i class="bi bi-hourglass-split text-warning"></i>
            </div>
            <h5 style="font-weight:500">Your Account is Under Review</h5>
            <p class="text-muted small mt-2 mb-4">
                Thank you for registering as an Owner on MessBasha.<br/>
                An administrator will review your details shortly.
            </p>
        </div>

        <div class="bg-light rounded p-3 mb-4" style="border: 0.5px solid #e0e0e0;">
            <p class="small fw-500 mb-2" style="color:#0F6E56; font-weight:500;">What happens next?</p>
            <div class="step">
                <div class="step-num">1</div>
                <div>
                    <div class="small fw-500">Submit your KYC</div>
                    <div class="text-muted" style="font-size:12px">Upload your NID and a live photo for identity verification.</div>
                </div>
            </div>
            <div class="step">
                <div class="step-num">2</div>
                <div>
                    <div class="small fw-500">Admin review</div>
                    <div class="text-muted" style="font-size:12px">Our team reviews your submission — usually within 24–48 hours.</div>
                </div>
            </div>
            <div class="step">
                <div class="step-num">3</div>
                <div>
                    <div class="small fw-500">Get approved & post listings</div>
                    <div class="text-muted" style="font-size:12px">Once approved, you can post rooms and manage applications freely.</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-column">
            <a asp-controller="UserDashboard" asp-action="Browse" class="btn btn-primary-brf text-center w-100">
                <i class="bi bi-search me-2"></i>Browse Listings While You Wait
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-brf text-center w-100">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
