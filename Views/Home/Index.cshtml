@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>MessBasha — Bangladesh's #1 Room Rental Platform</title>
    <meta name="description" content="Find verified bachelor rooms for rent in Dhaka, Chattogram, Sylhet and across Bangladesh."/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body style="font-family:'Inter',sans-serif">

<!-- Navbar -->
<nav class="brf-topbar">
    <a class="brf-brand" href="/"><i class="bi bi-house-door-fill"></i> MessBasha</a>
    <div class="d-flex gap-2">
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm">Logout</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login"    class="btn btn-outline-light btn-sm">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Register Free</a>
        }
    </div>
</nav>

<!-- Hero -->
<section class="hero-section" style="padding-top:5rem">
    <div class="container">
        <h1 class="display-5 fw-800">Find Your Perfect Bachelor Room<br/>Across Bangladesh 🇧🇩</h1>
        <p class="lead opacity-75">Verified listings · Secure applications · bKash & Nagad payments</p>
        <form asp-controller="UserDashboard" asp-action="Browse" method="get" class="hero-search mx-auto">
            <input name="Search" placeholder="Search by area, district..." class="form-control border-0"/>
            <button type="submit" class="btn btn-primary px-4">Search</button>
        </form>
        <div class="d-flex justify-content-center gap-4 mt-4 text-white-50 small">
            <span><i class="bi bi-building me-1"></i>1,000+ Listings</span>
            <span><i class="bi bi-shield-check me-1"></i>Verified Owners</span>
            <span><i class="bi bi-phone me-1"></i>bKash &amp; Nagad</span>
        </div>
    </div>
</section>

<!-- Features -->
<section class="py-5 bg-white">
    <div class="container">
        <h2 class="text-center fw-700 mb-4">Why Choose MessBasha?</h2>
        <div class="row g-4">
            @foreach (var (icon, title, desc, color, bg) in new[]{
                ("bi-shield-check","Verified Listings","All owners are KYC-verified for your safety","#16A34A","#DCFCE7"),
                ("bi-diagram-3","MessBoard","Manage groceries, cleaning, cooking rosters, fund and notices","#0F766E","#CCFBF1"),
                ("bi-phone-fill","Sandbox Payments","Owner number auto-fill, OTP, PIN and rent confirmation","#E2136E","#FCE7F3"),
                ("bi-chat-dots","Roommate Chat","Accepted roommate connections show profile cards and message links","#7c3aed","#EDE9FE")})
            {
                <div class="col-md-3 text-center">
                    <div style="width:64px;height:64px;border-radius:16px;background:@bg;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:@color">
                        <i class="bi @icon"></i>
                    </div>
                    <h5 class="fw-700">@title</h5>
                    <p class="text-muted small">@desc</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTAs -->
<section class="py-5" style="background:#f8fafc">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="brf-card p-4 text-center">
                    <i class="bi bi-search fs-1 text-primary"></i>
                    <h4 class="fw-700 mt-3">Looking for a Room?</h4>
                    <p class="text-muted">Browse hundreds of verified listings. Filter by rent, type, location.</p>
                    <a asp-controller="Account" asp-action="Register" asp-route-role="User" class="btn btn-primary px-4">Register as Tenant</a>
                </div>
            </div>
            <div class="col-md-5">
                <div class="brf-card p-4 text-center">
                    <i class="bi bi-building-add fs-1 text-warning"></i>
                    <h4 class="fw-700 mt-3">Have Rooms to Rent?</h4>
                    <p class="text-muted">List your rooms for free. Get verified applications. Manage everything in one place.</p>
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Owner" class="btn btn-warning px-4">Register as Owner</a>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="text-center py-4 text-muted small" style="background:#1e293b;color:#94a3b8!important">
    <div class="container"><p class="mb-0" style="color:#94a3b8">© 2025 MessBasha Bangladesh. Built with ❤️ for Bangladeshis.</p></div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
