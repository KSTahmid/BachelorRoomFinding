@model PagedResult<Room>
@{ViewData["Title"] = "Room Management";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-building me-2"></i>Room Management</h1>
    <a asp-controller="Room" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Room
    </a>
</div>

<div class="brf-card mb-3 p-3">
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search title or location..." style="max-width:300px"/>
        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="brf-card">
    <div class="table-responsive">
        <table class="table brf-table mb-0">
            <thead><tr>
                <th>Room</th><th>Owner</th><th>Location</th><th>Rent</th>
                <th>Type</th><th>Status</th><th>Views</th><th>Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td>
                        <div class="fw-600 small">@r.Title</div>
                        <div class="text-muted" style="font-size:.75rem">Posted @r.PostedDate.ToString("dd MMM yyyy")</div>
                    </td>
                    <td class="small">@r.Owner?.UserName</td>
                    <td class="small">@r.District, @r.Thana</td>
                    <td><span class="rent-badge" style="font-size:.8rem">৳@r.MonthlyRent.ToString("N0")</span></td>
                    <td><span class="badge bg-secondary">@r.RoomType</span></td>
                    <td>
                        <span class="badge-status @(r.Status==RoomStatus.Active?"badge-active":r.Status==RoomStatus.PendingApproval?"badge-pending":r.Status==RoomStatus.Rented?"badge-rented":"badge-draft")">
                            @r.Status
                        </span>
                    </td>
                    <td class="small">@r.ViewCount</td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            @if (r.Status == RoomStatus.PendingApproval)
                            {
                                <form asp-controller="Admin" asp-action="ApproveRoom" asp-route-id="@r.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-success btn-sm-action" title="Approve"><i class="bi bi-check-lg"></i></button>
                                </form>
                            }
                            @if (r.Status == RoomStatus.PendingApproval || r.Status == RoomStatus.Rented)
                            {
                                <form asp-controller="Admin" asp-action="RejectRoom" asp-route-id="@r.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-danger btn-sm-action" title="Reject / Mark Unavailable"><i class="bi bi-x-lg"></i></button>
                                </form>
                            }
                            <a asp-controller="Room" asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary btn-sm-action"><i class="bi bi-pencil"></i></a>
                            <a asp-controller="Room" asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger btn-sm-action"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8"><div class="empty-state py-4"><i class="bi bi-building"></i><h5>No rooms found</h5></div></td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="text-muted small">@Model.TotalCount rooms total</span>
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i==Model.PageNumber?"active":"")">
                        <a class="page-link" asp-action="Rooms" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
