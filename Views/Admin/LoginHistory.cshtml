@model PagedResult<LoginHistory>
@{ViewData["Title"] = "Login History";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-clock-history me-2"></i>Login History</h1>
</div>

<div class="brf-card mb-3 p-3">
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search username or IP..." style="max-width:300px"/>
        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="brf-card">
    <div class="table-responsive">
        <table class="table brf-table mb-0">
            <thead><tr>
                <th>User</th><th>Login Time</th><th>IP Address</th><th>Browser / Device</th><th>Result</th>
            </tr></thead>
            <tbody>
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td class="fw-600 small">@l.User?.UserName <span class="text-muted">(@l.User?.Email)</span></td>
                    <td class="small">@l.LoginAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                    <td class="small"><code>@(l.IpAddress ?? "—")</code></td>
                    <td class="small text-muted" style="max-width:250px;overflow:hidden;text-overflow:ellipsis">@(l.UserAgent ?? "—")</td>
                    <td>
                        @if (l.IsSuccess)
                        { <span class="badge-status badge-approved"><i class="bi bi-check-circle me-1"></i>Success</span> }
                        else
                        { <span class="badge-status badge-rejected"><i class="bi bi-x-circle me-1"></i>Failed</span> }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5"><div class="empty-state py-4"><i class="bi bi-clock-history"></i><h5>No login records</h5></div></td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-end">
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i==Model.PageNumber?"active":"")">
                        <a class="page-link" asp-action="LoginHistory" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
