@model Room
@{
    ViewData["Title"] = "Post Room";
}

<div class="page-header">
    <h4><i class="bi bi-building-add me-2 text-primary"></i>Post New Room</h4>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Spacious bachelor room near university" required />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the room, facilities, rules..." required></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Address <span class="text-danger">*</span></label>
                            <input asp-for="Address" class="form-control" placeholder="Full address with area" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Rent" class="form-label fw-semibold">Monthly Rent (৳) <span class="text-danger">*</span></label>
                            <input asp-for="Rent" type="number" class="form-control" min="0" step="500" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BedroomCount" class="form-label fw-semibold">Bedrooms <span class="text-danger">*</span></label>
                            <input asp-for="BedroomCount" type="number" class="form-control" min="1" max="10" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OwnerId" class="form-label fw-semibold">Owner <span class="text-danger">*</span></label>
                            <select asp-for="OwnerId" class="form-select" required>
                                <option value="">-- Select Owner --</option>
                                @foreach (var user in (IEnumerable<User>)ViewBag.Owners)
                                {
                                    <option value="@user.UserId">@user.UserName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Availability</label>
                            <div class="form-check mt-1">
                                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                                <label class="form-check-label">Available for rent</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Post Room</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
