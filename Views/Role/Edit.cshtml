@model Role
@{
    ViewData["Title"] = "Edit Role";
}

<div class="page-header">
    <h4><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Role</h4>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                        <input asp-for="RoleName" class="form-control" required />
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RoleDescription" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="RoleDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update Role</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
