@model Room
@{
    ViewData["Title"] = "Edit Room";
}

<div class="page-header">
    <h4><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Room</h4>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="PostedDate" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Title</label>
                            <input asp-for="Title" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Rent" class="form-label fw-semibold">Monthly Rent (৳)</label>
                            <input asp-for="Rent" type="number" class="form-control" min="0" step="500" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BedroomCount" class="form-label fw-semibold">Bedrooms</label>
                            <input asp-for="BedroomCount" type="number" class="form-control" min="1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OwnerId" class="form-label fw-semibold">Owner</label>
                            <select asp-for="OwnerId" class="form-select">
                                @foreach (var user in (IEnumerable<User>)ViewBag.Owners)
                                {
                                    <option value="@user.UserId">@user.UserName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Availability</label>
                            <div class="form-check mt-1">
                                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                                <label class="form-check-label">Available for rent</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update Room</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
