@model PagedResult<User>
@{ViewData["Title"] = "User Management";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-people me-2"></i>User Management</h1>
    <a asp-controller="User" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add User
    </a>
</div>

<div class="brf-card mb-3 p-3">
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name or email..." style="max-width:300px"/>
        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="brf-card">
    <div class="table-responsive">
        <table class="table brf-table mb-0">
            <thead><tr>
                <th>User</th><th>Email</th><th>Phone</th><th>Role</th>
                <th>Status</th><th>KYC</th><th>Last Login</th><th>Actions</th>
            </tr></thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8"><div class="empty-state py-4"><i class="bi bi-people"></i><h5>No users found</h5></div></td></tr>
            }
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar-sm" style="background:@(u.Role?.RoleName=="Admin"?"#DC2626":u.Role?.RoleName=="Owner"?"#D97706":"#2563EB")">
                                @(u.UserName.Length > 0 ? u.UserName[0].ToString().ToUpper() : "U")
                            </div>
                            <div>
                                <div class="fw-600 small">@u.UserName</div>
                                @if (u.IsVerified) { <span class="verified-badge"><i class="bi bi-patch-check-fill"></i> Verified</span> }
                            </div>
                        </div>
                    </td>
                    <td class="small">@u.Email</td>
                    <td class="small">@(u.PhoneNumber ?? "—")</td>
                    <td><span class="badge @(u.Role?.RoleName=="Admin"?"bg-danger":u.Role?.RoleName=="Owner"?"bg-warning text-dark":"bg-primary")">@u.Role?.RoleName</span></td>
                    <td>
                        <span class="badge-status @(u.AccountStatus==AccountStatus.Active?"badge-active":u.AccountStatus==AccountStatus.Suspended?"badge-suspended":"badge-pending")">
                            @u.AccountStatus
                        </span>
                    </td>
                    <td><span class="badge-status @(u.IsVerified?"badge-approved":"badge-pending")">@(u.IsVerified?"Verified":"Pending")</span></td>
                    <td class="small text-muted">@(u.LastLogin?.ToString("dd MMM yy HH:mm") ?? "Never")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-controller="User" asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-primary btn-sm-action"><i class="bi bi-pencil"></i></a>
                            @if (!u.IsApprovedByAdmin)
                            {
                                <form asp-controller="Admin" asp-action="ApproveUser" asp-route-id="@u.UserId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-success btn-sm-action" title="Approve"><i class="bi bi-check-lg"></i></button>
                                </form>
                            }
                            @if (u.AccountStatus != AccountStatus.Suspended)
                            {
                                <form asp-controller="Admin" asp-action="SuspendUser" asp-route-id="@u.UserId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-warning btn-sm-action" title="Suspend"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                            <a asp-controller="User" asp-action="Delete" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-danger btn-sm-action"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount users</span>
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Users" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
