@model List<RoommateAd>
@using BachelorRoomFinding.Services
@{
    ViewData["Title"] = "Find Roommate";
    var myPrefs     = ViewBag.MyPrefs as UserPreference;
    var otherPrefs  = (ViewBag.OtherPrefs as List<UserPreference>) ?? new List<UserPreference>();
    var currentUid  = Context.Session.GetInt32("UserId");
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-0"><i class="bi bi-people me-2"></i>Find a Roommate</h1>
        <p class="text-muted small mb-0">Browse ads and see how well your lifestyle matches theirs</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Connected" class="btn btn-outline-primary">
            <i class="bi bi-chat-dots me-1"></i>Connected
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Post My Ad
        </a>
    </div>
</div>

@if (myPrefs == null && currentUid != null)
{
    <div class="alert alert-info d-flex align-items-start gap-3 mb-4" style="border-radius:12px; border:0.5px solid #bee3f8;">
        <i class="bi bi-info-circle fs-5 mt-1"></i>
        <div>
            <strong>Set your lifestyle preferences</strong> to see how well you match with each person.
            <a asp-action="Create" class="ms-2 fw-500" style="color:#0F6E56">Post an ad to set preferences →</a>
        </div>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="brf-card p-5 text-center">
                <i class="bi bi-people fs-1 text-muted opacity-25"></i>
                <h5 class="mt-3">No roommate ads yet</h5>
                <p class="text-muted">Be the first to post an ad in your area!</p>
                <a asp-action="Create" class="btn btn-primary mt-2">Post an Ad</a>
            </div>
        </div>
    }

    @foreach (var ad in Model.OrderByDescending(a => a.CreatedAt))
    {
        var targetPrefs = otherPrefs.FirstOrDefault(p => p.UserId == ad.UserId);
        int score = (myPrefs != null && targetPrefs != null)
            ? MatchingService.CalculateCompatibility(myPrefs, targetPrefs)
            : -1; // -1 = no preferences set

        // Color logic
        string scoreBg    = score >= 80 ? "#D1FAE5" : score >= 50 ? "#FEF9C3" : score >= 0 ? "#FEE2E2" : "#F3F4F6";
        string scoreColor = score >= 80 ? "#065F46" : score >= 50 ? "#92400E" : score >= 0 ? "#991B1B" : "#6B7280";
        string scoreLabel = score >= 80 ? "Great Match" : score >= 50 ? "Decent Match" : score >= 0 ? "Low Match" : "No Prefs";

        <div class="col-md-6 col-xl-4">
            <div class="brf-card h-100 overflow-hidden" style="border-radius:12px; border:0.5px solid #e0e0e0;">

                <!-- Header -->
                <div class="p-3 d-flex justify-content-between align-items-center" style="border-bottom:0.5px solid #f0f0f0;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-sm" style="width:42px;height:42px;font-size:1rem;background:#0F6E56">
                            @ad.User.UserName[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div class="fw-500 small">@ad.User.UserName</div>
                            <div class="text-muted" style="font-size:.7rem">Posted @ad.CreatedAt.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <!-- Match Badge -->
                    <div class="text-end">
                        <span class="badge rounded-pill px-2 py-1" style="background:@scoreBg; color:@scoreColor; font-size:.72rem; font-weight:500;">
                            @(score >= 0 ? score + "% · " + scoreLabel : scoreLabel)
                        </span>
                    </div>
                </div>

                <!-- Body -->
                <div class="p-3">
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge" style="background:#E1F5EE;color:#085041;font-weight:400;font-size:.72rem;">
                            <i class="bi bi-geo-alt me-1"></i>@ad.PreferredAreas
                        </span>
                        <span class="badge" style="background:#E1F5EE;color:#085041;font-weight:400;font-size:.72rem;">
                            <i class="bi bi-cash-stack me-1"></i>৳@ad.MaxRentPerPerson.ToString("N0")/mo
                        </span>
                    </div>

                    <p class="small text-muted mb-3" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        @ad.Description
                    </p>

                    <!-- Compatibility Breakdown (only when both have prefs) -->
                    @if (myPrefs != null && targetPrefs != null)
                    {
                        <div class="p-2 rounded mb-3" style="background:#F9FAFB; border:0.5px solid #E5E7EB;">
                            <p class="text-muted mb-2" style="font-size:.68rem; font-weight:500; text-transform:uppercase; letter-spacing:.04em;">Lifestyle Compatibility</p>
                            @{
                                var habits = new[]
                                {
                                    ("Smoking",       myPrefs.Smoking,       targetPrefs.Smoking,       "bi-wind"),
                                    ("Sleep",         myPrefs.SleepSchedule, targetPrefs.SleepSchedule, "bi-moon"),
                                    ("Cleanliness",   myPrefs.Cleanliness,   targetPrefs.Cleanliness,   "bi-stars"),
                                    ("Food",          myPrefs.FoodHabit,     targetPrefs.FoodHabit,     "bi-egg-fried"),
                                    ("Guest Policy",  myPrefs.GuestPolicy,   targetPrefs.GuestPolicy,   "bi-person-check"),
                                };
                            }
                            @foreach (var (label, mine, theirs, icon) in habits)
                            {
                                bool match = string.Equals(mine, theirs, StringComparison.OrdinalIgnoreCase)
                                          || mine == "Flexible" || theirs == "Flexible"
                                          || mine == "Both"     || theirs == "Both";
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted"><i class="bi @icon me-1"></i>@label</span>
                                    <span style="font-size:.7rem; color:@(match?"#065F46":"#991B1B");">
                                        <i class="bi @(match ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @theirs
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    <div class="d-flex gap-2 mb-3" style="font-size:.72rem; color:#6B7280;">
                        <span><i class="bi bi-calendar me-1"></i>Move-in @ad.MoveInDate.ToString("MMM yyyy")</span>
                        <span><i class="bi bi-person-plus me-1"></i>@ad.NumberOfRoommatesNeeded needed</span>
                    </div>

                    @if (currentUid.HasValue && currentUid.Value != ad.UserId)
                    {
                        <button class="btn btn-sm w-100"
                                style="background:#0F6E56;color:#fff;border-radius:8px;font-size:.8rem;"
                                data-bs-toggle="modal" data-bs-target="#connectModal_@ad.Id">
                            <i class="bi bi-chat-dots me-1"></i>Connect
                        </button>
                    }
                    else if (!currentUid.HasValue)
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-sm w-100" style="border:0.5px solid #0F6E56;color:#0F6E56;border-radius:8px;font-size:.8rem;">
                            Login to Connect
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Connection Modal -->
        @if (currentUid.HasValue && currentUid.Value != ad.UserId)
        {
            <div class="modal fade" id="connectModal_@ad.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius:12px; border:0.5px solid #e0e0e0;">
                        <div class="modal-header" style="border-bottom:0.5px solid #f0f0f0;">
                            <div>
                                <h6 class="modal-title mb-0 fw-500">Connect with @ad.User.UserName</h6>
                                @if (score >= 0)
                                {
                                    <span class="badge rounded-pill mt-1" style="background:@scoreBg;color:@scoreColor;font-size:.7rem;">@score% @scoreLabel</span>
                                }
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="Connect" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="adId" value="@ad.Id" />
                            <div class="modal-body">
                                <p class="small text-muted">Introduce yourself and mention why you'd be a great roommate.</p>
                                <textarea name="message" class="form-control" rows="4"
                                          placeholder="Hi, I saw your ad and I'm interested in sharing..." required
                                          style="border-radius:8px;font-size:.85rem;"></textarea>
                            </div>
                            <div class="modal-footer" style="border-top:0.5px solid #f0f0f0;">
                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm" style="background:#0F6E56;color:#fff;border-radius:8px;">Send Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
