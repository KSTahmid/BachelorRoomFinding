@model List<SavedRoom>
@{ViewData["Title"] = "Saved Rooms";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-bookmark-heart me-2 text-warning"></i>Saved Rooms</h1>
    <a asp-action="Browse" class="btn btn-outline-primary btn-sm">Browse More</a>
</div>

@if (!Model.Any())
{
    <div class="brf-card"><div class="empty-state">
        <i class="bi bi-bookmark"></i>
        <h5>No saved rooms</h5><p>Browse rooms and click the bookmark icon to save them here</p>
        <a asp-action="Browse" class="btn btn-primary btn-sm mt-2">Browse Rooms</a>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var s in Model)
        {
            var photo = s.Room?.Photos?.FirstOrDefault(p => p.IsPrimary) ?? s.Room?.Photos?.FirstOrDefault();
            <div class="col-md-6 col-lg-4">
                <div class="room-card">
                    @if (photo != null)
                    { <img src="@photo.PhotoPath" class="room-card-img" alt="@s.Room?.Title"/> }
                    else
                    { <div class="room-card-img-placeholder"><i class="bi bi-building text-muted" style="font-size:2rem"></i></div> }
                    <div class="p-3">
                        <h6 class="fw-700 mb-1">@s.Room?.Title</h6>
                        <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@s.Room?.Thana, @s.Room?.District</div>
                        <div class="rent-badge mb-2">৳@s.Room?.Rent.ToString("N0")/mo</div>
                        <div class="text-muted" style="font-size:.73rem">Saved @s.SavedAt.ToString("dd MMM yyyy")</div>
                        <div class="d-flex gap-2 mt-2">
                            <a asp-action="RoomDetail" asp-route-id="@s.RoomId" class="btn btn-primary btn-sm flex-fill">View Details</a>
                            <form asp-action="UnsaveRoom" asp-route-roomId="@s.RoomId" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-danger btn-sm" title="Remove"><i class="bi bi-bookmark-x"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
