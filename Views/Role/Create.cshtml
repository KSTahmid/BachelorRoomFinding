@model Role
@{
    ViewData["Title"] = "Create Role";
}

<div class="page-header">
    <h4><i class="bi bi-shield-plus me-2 text-primary"></i>Create New Role</h4>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                        <input asp-for="RoleName" class="form-control" placeholder="e.g. Admin, User, Moderator" required />
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RoleDescription" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="RoleDescription" class="form-control" rows="3" placeholder="Brief description of this role's permissions..."></textarea>
                        <span asp-validation-for="RoleDescription" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Role</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
