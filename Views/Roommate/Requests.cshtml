@model List<RoommateConnectionRequest>
@{ViewData["Title"] = "Roommate Requests";}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-person-plus me-2"></i>Roommate Requests</h1>
</div>

<div class="brf-card">
    <div class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <div class="empty-state py-4"><i class="bi bi-person-plus"></i><h5>No requests yet</h5></div>
        }
        @foreach (var request in Model)
        {
            <div class="list-group-item p-3 d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-bold">@request.Sender.UserName</div>
                    <p class="small text-muted mb-1">@request.Message</p>
                    <span class="badge-status @(request.Status == ConnectionRequestStatus.Accepted ? "badge-approved" : request.Status == ConnectionRequestStatus.Rejected ? "badge-rejected" : "badge-pending")">@request.Status</span>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    @if (request.Status == ConnectionRequestStatus.Pending)
                    {
                        <form asp-action="Respond" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <input type="hidden" name="status" value="@ConnectionRequestStatus.Accepted" />
                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Accept</button>
                        </form>
                        <form asp-action="Respond" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <input type="hidden" name="status" value="@ConnectionRequestStatus.Rejected" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg me-1"></i>Decline</button>
                        </form>
                    }
                    else if (request.Status == ConnectionRequestStatus.Accepted)
                    {
                        <a asp-controller="Message" asp-action="Conversation" asp-route-userId="@request.SenderUserId" class="btn btn-sm btn-primary">
                            <i class="bi bi-chat-dots me-1"></i>Message
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
